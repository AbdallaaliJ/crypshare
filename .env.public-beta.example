# CrypShare public-beta production template.
# Copy to your deployment environment manager, replace every placeholder, and do not commit real secrets.

NODE_ENV=production
CRYPSHARE_PUBLIC_DEPLOYMENT=true
TRUST_PROXY=true

PORT=3001
BACKEND_PORT=3001
FRONTEND_PORT=8080

# Public origin of the frontend, for example https://drive.example.com
CORS_ORIGINS=https://replace-with-your-frontend-domain.example
VITE_API_BASE_URL=/api

# PostgreSQL
DATABASE_DRIVER=postgres
POSTGRES_DB=crypshare
POSTGRES_USER=crypshare
POSTGRES_PASSWORD=replace-with-long-random-postgres-password
DATABASE_URL=postgres://crypshare:replace-with-long-random-postgres-password@postgres:5432/crypshare

# Encrypted blob storage: MinIO/S3-compatible storage.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://minio:9000
S3_BUCKET=crypshare-vault
S3_ACCESS_KEY=replace-with-long-random-s3-access-key
S3_SECRET_KEY=replace-with-long-random-s3-secret-key
S3_REGION=us-east-1
S3_USE_SSL=false
MINIO_ROOT_USER=replace-with-long-random-s3-access-key
MINIO_ROOT_PASSWORD=replace-with-long-random-s3-secret-key

# Browser auth. Use secure HttpOnly cookies for real public deployments.
SESSION_TTL_MS=28800000
SESSION_COOKIE_ENABLED=true
SESSION_RETURN_BEARER_TOKEN=false
SESSION_COOKIE_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict
VITE_SESSION_COOKIE_ENABLED=true

# Request limits and quotas.
JSON_BODY_LIMIT=256kb
UPLOAD_FILE_LIMIT_BYTES=16106127360
UPLOAD_FIELD_LIMIT_BYTES=262144
VAULT_CHUNK_UPLOAD_LIMIT_BYTES=8388608
VAULT_UPLOAD_SESSION_TTL_MS=14400000
USER_STORAGE_QUOTA_BYTES=107374182400
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_MAX=30
WORKSPACE_INVITE_TTL_MS=604800000

# TURN relay-only P2P.
P2P_SESSION_TTL_MS=900000
P2P_SIGNAL_MAX_BYTES=262144
P2P_MAX_SOCKETS_PER_USER=5
P2P_MAX_ACTIVE_SESSIONS_PER_USER=20
P2P_MAX_SIGNALING_TICKETS_PER_USER=5
P2P_STUN_URLS=
P2P_TURN_URLS=turn:replace-with-turn-domain.example:3478?transport=tcp
P2P_TURN_SHARED_SECRET=replace-with-long-random-coturn-shared-secret
P2P_TURN_CREDENTIAL_TTL_MS=600000
