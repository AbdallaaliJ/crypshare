# CrypShare public-beta defaults.
# Copy values into your deployment environment; do not commit real secrets or production paths.

# Backend
PORT=3001
DATABASE_FILE=./backend/data/crypshare.db
LEGACY_STATE_FILE=./backend/data/state.json
SESSION_TTL_MS=28800000
CORS_ORIGINS=http://localhost:5174,http://localhost:5175
JSON_BODY_LIMIT=256kb
# Public-beta single-request encrypted upload limit. 16106127360 = 15 GiB.
# Multi-terabyte files need resumable encrypted chunk upload instead of one multipart request.
UPLOAD_FILE_LIMIT_BYTES=16106127360
UPLOAD_FIELD_LIMIT_BYTES=262144
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_MAX=30
WORKSPACE_INVITE_TTL_MS=604800000
P2P_SESSION_TTL_MS=900000
P2P_STUN_URLS=stun:stun.l.google.com:19302
P2P_TURN_URLS=
P2P_TURN_USERNAME=
P2P_TURN_CREDENTIAL=

# Frontend
VITE_API_BASE_URL=http://localhost:3001
