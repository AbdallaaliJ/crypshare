# CrypShare public-beta defaults.
# Copy values into your deployment environment; do not commit real secrets or production paths.

# Backend
PORT=3001
BACKEND_PORT=3001
FRONTEND_PORT=8080
CRYPSHARE_PUBLIC_DEPLOYMENT=false
TRUST_PROXY=false
DATABASE_FILE=./backend/data/crypshare.db
LEGACY_STATE_FILE=./backend/data/state.json
UPLOAD_DIR=./backend/uploads
# Encrypted blob storage. Use local for development; use s3 for MinIO/AWS S3-compatible public-beta storage.
STORAGE_DRIVER=local
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=crypshare-vault
S3_ACCESS_KEY=replace-with-minio-access-key
S3_SECRET_KEY=replace-with-long-minio-secret-key
S3_REGION=us-east-1
S3_USE_SSL=false
# PostgreSQL service defaults for docker-compose.public-beta.yml.
# Local development can keep DATABASE_DRIVER=sqlite; public-beta compose uses postgres.
DATABASE_DRIVER=sqlite
POSTGRES_DB=crypshare
POSTGRES_USER=crypshare
POSTGRES_PASSWORD=replace-with-long-postgres-password
POSTGRES_PORT=5432
DATABASE_URL=postgres://crypshare:replace-with-long-postgres-password@127.0.0.1:5432/crypshare
SESSION_TTL_MS=28800000
SESSION_COOKIE_ENABLED=false
SESSION_RETURN_BEARER_TOKEN=true
SESSION_COOKIE_NAME=__Host-crypshare_session
CSRF_COOKIE_NAME=__Host-crypshare_csrf
CSRF_HEADER_NAME=x-csrf-token
# Required when SESSION_COOKIE_ENABLED=true in production. Use a long random secret.
SESSION_COOKIE_SECRET=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=strict
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
JSON_BODY_LIMIT=256kb
# Public-beta encrypted vault size limit. 16106127360 = 15 GiB.
# Multi-terabyte deployments need object storage, quotas, and resumable download support.
UPLOAD_FILE_LIMIT_BYTES=16106127360
UPLOAD_FIELD_LIMIT_BYTES=262144
# Per-request encrypted vault chunk limit. Keep above frontend encrypted chunk size.
VAULT_CHUNK_UPLOAD_LIMIT_BYTES=8388608
VAULT_UPLOAD_SESSION_TTL_MS=14400000
# Owner-paid encrypted vault quota. 107374182400 = 100 GiB. Set 0 only for trusted local testing.
USER_STORAGE_QUOTA_BYTES=107374182400
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_WINDOW_MS=300000
AUTH_RATE_LIMIT_MAX=30
WORKSPACE_INVITE_TTL_MS=604800000
P2P_SESSION_TTL_MS=900000
P2P_SIGNAL_MAX_BYTES=262144
P2P_MAX_SOCKETS_PER_USER=5
P2P_MAX_ACTIVE_SESSIONS_PER_USER=20
P2P_MAX_SIGNALING_TICKETS_PER_USER=5
P2P_STUN_URLS=
# TURN is required because CrypShare P2P uses relay-only WebRTC for this privacy mode.
# Local defaults match docker-compose.turn.yml. Replace them for any public deployment.
P2P_TURN_URLS=turn:127.0.0.1:3478?transport=tcp,turn:127.0.0.1:3478?transport=udp
P2P_TURN_SHARED_SECRET=dev-only-turn-shared-secret-change-me
P2P_TURN_CREDENTIAL_TTL_MS=600000
# Static TURN credentials are intentionally blank. Public deployments should use P2P_TURN_SHARED_SECRET.
P2P_TURN_USERNAME=
P2P_TURN_CREDENTIAL=

# Optional local coturn defaults for docker-compose.turn.yml. Do not use these values in production.
TURN_REALM=crypshare.local
TURN_EXTERNAL_IP=127.0.0.1
TURN_SHARED_SECRET=dev-only-turn-shared-secret-change-me

# Optional MinIO defaults for docker-compose.public-beta.yml. Do not use these values in production.
MINIO_ROOT_USER=replace-with-minio-access-key
MINIO_ROOT_PASSWORD=replace-with-long-minio-secret-key
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Frontend
VITE_API_BASE_URL=http://localhost:3001
# Set true only when the backend also has SESSION_COOKIE_ENABLED=true.
VITE_SESSION_COOKIE_ENABLED=false
